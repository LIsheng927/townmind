# 复制为 .env 并填写（.env 已被 .gitignore 忽略，不会提交）
# anthropic 或 openai；留空/没有 key 时 NPC 自动使用规则兜底
TOWNMIND_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 可选：覆盖默认模型名
TOWNMIND_MODEL=

# ---- 可选增强：留空就是关闭，填任意非空值（比如 1）打开 ----
# 让大模型给每条新记忆打重要度分，代替写死的常量。每轮多一次 LLM 调用。
TOWNMIND_DYNAMIC_IMPORTANCE=
# 累计重要度过阈值就反思一次，把若干事件提炼成更高层的认识（还会再往上提炼一层二级反思）。
TOWNMIND_USE_REFLECTION=
# 给每个人单独记一份好感/信任，影响说话语气；每场对话结束后多一次 LLM 调用。
TOWNMIND_USE_RELATIONSHIPS=
# NPC 会主动把"够重要、还没跟对方讲过"的事说出去（八卦）。不额外花 LLM 调用。
# 跟 TOWNMIND_USE_RELATIONSHIPS 一起开时，信不过的人不会被告知。
TOWNMIND_USE_GOSSIP=
# 对话结束时把这场的逐句流水账压成一条摘要。每场对话多一次 LLM 调用，换来同样的
# 记忆容量能装下大约十倍长的历史。注意：原始逐句记录会被**永久替换掉**。
TOWNMIND_COMPRESS_CONVERSATIONS=
# 下面两个真实数据没测出正向收益，保持关闭；接上环境变量只是为了方便重新验证。
# CoVe 式重试：出口检查拦下的回复不直接兜底，先带着被拦内容让大模型重说一次。
TOWNMIND_VERIFY_AND_REVISE=
# Reflexion 式教训：分类器实锤一次编造后，额外存一条高重要度的"教训"记忆。
TOWNMIND_REFLEXION_LESSONS=
# 自研 LoRA 防编造分类器（要先 uv sync --group guard-model 并训练出 adapter，
# 见 guard/README.md）。没装依赖/没有 adapter 时会优雅跳过，不影响服务启动。
TOWNMIND_USE_GUARD_MODEL=
